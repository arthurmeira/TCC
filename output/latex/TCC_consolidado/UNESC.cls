\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{UNESC}[2026/10/17 Classe de compatibilidade para artigo UNESC]
\LoadClass[12pt,a4paper]{article}
\RequirePackage[left=3cm,right=2cm,top=3cm,bottom=2cm]{geometry}
\RequirePackage{titlesec}
\RequirePackage{indentfirst}
\RequirePackage{fancyhdr}
\setlength{\parindent}{2cm}
\setlength{\parskip}{0pt}
\setlength{\columnsep}{1cm}
\titleformat{\section}{\bfseries\normalsize}{\thesection}{1em}{\MakeUppercase}
\titleformat{\subsection}{\normalfont\normalsize}{\thesubsection}{1em}{\MakeUppercase}
\titleformat{\subsubsection}{\normalfont\normalsize}{\thesubsubsection}{1em}{\MakeUppercase}
\titlespacing*{\section}{0pt}{1.5em}{0.7em}
\titlespacing*{\subsection}{0pt}{1.2em}{0.5em}
\titlespacing*{\subsubsection}{0pt}{1em}{0.4em}
\pagestyle{plain}
\renewcommand{\maketitle}{%
  \begin{center}
    {\bfseries\MakeUppercase{\@title}\par}
    \vspace{2.3em}
    {\@author\par}
  \end{center}
  \vspace{2.5em}
}
\AtBeginDocument{\raggedbottom}
